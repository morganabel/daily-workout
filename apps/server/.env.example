# Server environment (Next.js API)
#
# One server app serves both deployment modes; DEPLOYMENT_MODE selects behavior:
#   self-hosted (default): permissive providers, billing disabled.
#   hosted:                Better Auth required; RevenueCat billing optional.

# Deployment mode: self-hosted | hosted
DEPLOYMENT_MODE=self-hosted

# AI provider key. In self-hosted, leave blank to rely on BYOK + mock fallback.
OPENAI_API_KEY=sk-your-key-here

# Better Auth
# Setting DATABASE_URL switches auth from stub to Better Auth automatically.
DATABASE_URL=postgres://user:password@localhost:5432/workout_agent
BETTER_AUTH_SECRET=change-me
AUTH_MODE=better-auth
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:19006

# --- Hosted mode only ---
# Billing provider: none (default) | revenuecat
# BILLING_PROVIDER=revenuecat
# RevenueCat webhook auth (required once billing is enabled)
# REVENUECAT_WEBHOOK_SECRET=change-me
# REVENUECAT_DEFAULT_OFFERING_ID=
# Included-generation quota windows
# HOSTED_FREE_GENERATION_LIMIT=25
# HOSTED_PRO_GENERATION_LIMIT=1000
# HOSTED_QUOTA_WINDOW_DAYS=30

# --- Backward-compat (deprecated) ---
# EDITION=HOSTED and HOSTED_BILLING_ENABLED=true are still honored as aliases
# for DEPLOYMENT_MODE=hosted and BILLING_PROVIDER=revenuecat, respectively.
