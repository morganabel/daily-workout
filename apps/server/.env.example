# Server environment (Next.js API)
#
# One server app serves both deployment modes; DEPLOYMENT_MODE selects behavior:
#   self-hosted (default): permissive providers, billing disabled.
#   hosted:                Better Auth required; RevenueCat billing optional.

# Deployment mode: self-hosted | hosted
DEPLOYMENT_MODE=self-hosted

# AI provider selection and managed keys. In self-hosted, leave keys blank to rely on BYOK.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional provider model overrides
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PLANNER_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_PLANNER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TIMEOUT_MS=60000

# Better Auth
# Setting DATABASE_URL switches auth from stub to Better Auth automatically.
DATABASE_URL=postgres://user:password@localhost:5432/workout_agent
BETTER_AUTH_SECRET=change-me
AUTH_MODE=better-auth
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:19006

# --- Hosted mode only ---
# Billing provider: none (default) | revenuecat
# BILLING_PROVIDER=revenuecat
# Strict versioned non-secret billing document (required once billing is enabled).
# Deployment owners should serialize a typed object; see ../../billing-config.example.json.
# BILLING_CONFIG_JSON={"schemaVersion":1,"revenueCat":{"appIds":["app.test"],"environments":["SANDBOX"],"entitlementIds":["OpenLift Pro"],"productIds":["monthly"]},"plans":{"freeGenerations":25,"proGenerations":1000,"windowDays":30},"guardrails":{"accountRequestsPerMinute":30,"accountMaxActiveGenerations":2,"accountDailySpendLimitNanoUsd":"5000000000","globalDailySpendLimitNanoUsd":"50000000000","pendingReservationTtlSeconds":300},"capabilities":{"showUpgradeUi":true}}
# RevenueCat webhook auth remains separate for secret rotation.
# REVENUECAT_WEBHOOK_SECRET=change-me
