# Server environment (Next.js API)
# In CE/self-host: set OPENAI_API_KEY to your own key or leave blank to rely on BYOK + mock fallback.
# In hosted: use the hosted overlay app/repo (this `apps/server` wiring is CE-only).

OPENAI_API_KEY=sk-your-key-here
EDITION=CE

# Better Auth
DATABASE_URL=postgres://user:password@localhost:5432/workout_agent
BETTER_AUTH_SECRET=change-me
AUTH_MODE=better-auth
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:19006
