# Mobile environment (Expo app)
# Point the client at your API server. Use your LAN IP when testing on a device.

EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# Optional: build-time hint for whether the backend uses Better Auth.
# Defaults to "true" so the app can show auth-first onboarding even if /api/meta is slow.
# Set to "false" for stub-auth-only backends.
EXPO_PUBLIC_AUTH_ENABLED=true
