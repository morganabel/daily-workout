{
  "name": "@workout-agent-ce/source",
  "version": "0.0.0",
  "packageManager": "npm@12.0.1",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "nx dev server",
    "dev": "npm run dev:server & nx start mobile",
    "dev:server": "nx run @workout-agent-ce/server:build-deps && nx run @workout-agent-ce/server:dev",
    "dev:server:db": "DATABASE_URL=postgres://user:password@localhost:5432/workout_agent BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-dev-secret BETTER_AUTH_URL=http://localhost:3000 sh -c 'npm run db:up && npm run db:wait && npm run db:migrate && nx run @workout-agent-ce/server:build-deps && nx run @workout-agent-ce/server:dev'",
    "dev:mobile": "nx start mobile",
    "debug:mcp:mobile": "node ./tools/mobile-debug-mcp/server.mjs",
    "db:up": "docker compose up -d db",
    "db:wait": "sh -c 'until docker compose exec -T db pg_isready -U user -d workout_agent >/dev/null 2>&1; do sleep 0.5; done'",
    "db:migrate": "sh -c 'cd packages/server-db && npx drizzle-kit migrate'",
    "db:generate": "sh -c 'cd packages/server-db && npx drizzle-kit generate --name schema --prefix index'",
    "db:logs": "docker compose logs -f db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "better-auth:generate": "nx run server-auth:build && auth generate --config apps/server/src/lib/auth.ts --output packages/server-db/src/lib/schema.ts --yes",
    "lint": "nx run-many --target=lint",
    "test": "nx run-many --target=test",
    "typecheck": "nx run-many --target=typecheck",
    "validate:nx-targets": "node ./tools/scripts/check-required-nx-targets.mjs",
    "validate:openspec": "openspec validate --strict --no-interactive --no-color",
    "validate:generation-scenarios": "nx test @workout-agent/shared --testPathPatterns=src/lib/evaluation/workout-generation-scenarios.spec.ts",
    "evaluate:generation": "node ./tools/scripts/run-generation-evaluation.mjs",
    "review:generation": "node ./tools/scripts/review-generation-report.mjs",
    "promptfoo:generation": "node ./tools/scripts/run-promptfoo-generation-evaluation.mjs",
    "promptfoo:generation:view": "node ./tools/scripts/view-promptfoo-generation-report.mjs",
    "promptfoo:generation:redteam": "node ./tools/scripts/run-promptfoo-generation-redteam.mjs",
    "build": "nx run-many --target=build"
  },
  "private": true,
  "dependencies": {
    "@better-auth/expo": "1.7.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "expo": "^57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "next": "~15.5.24",
    "openai": "^6.8.1",
    "pg": "^8.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-get-random-values": "^1.10.0",
    "react-native-purchases": "^9.7.6",
    "react-native-purchases-ui": "^9.7.6",
    "react-native-root-siblings": "^5.0.0",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "^0.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
