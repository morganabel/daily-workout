{
  "name": "@workout-agent-ce/source",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "nx dev server",
    "dev": "npm run dev:server & nx start mobile",
    "dev:server": "nx run @workout-agent-ce/server:build-deps && nx run @workout-agent-ce/server:dev",
    "dev:server:db": "DATABASE_URL=postgres://user:password@localhost:5432/workout_agent BETTER_AUTH_SECRET=dev-secret-dev-secret-dev-secret-dev-secret BETTER_AUTH_URL=http://localhost:3000 sh -c 'npm run db:up && npm run db:wait && npm run db:migrate && nx run @workout-agent-ce/server:build-deps && nx run @workout-agent-ce/server:dev'",
    "dev:mobile": "nx start mobile",
    "db:up": "docker compose up -d db",
    "db:wait": "sh -c 'until docker compose exec -T db pg_isready -U user -d workout_agent >/dev/null 2>&1; do sleep 0.5; done'",
    "db:migrate": "sh -c 'cd packages/server-db && npx drizzle-kit migrate'",
    "db:generate": "sh -c 'cd packages/server-db && npx drizzle-kit generate --name schema --prefix index'",
    "db:logs": "docker compose logs -f db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "better-auth:generate": "nx run server-auth:build && better-auth generate --config apps/server/src/lib/auth.ts --output packages/server-db/src/lib/schema.ts --yes",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "validate:generation-scenarios": "nx test @workout-agent/shared --testPathPatterns=src/lib/evaluation/workout-generation-scenarios.spec.ts",
    "evaluate:generation": "node ./tools/scripts/run-generation-evaluation.mjs",
    "review:generation": "node ./tools/scripts/review-generation-report.mjs",
    "build": "nx run-many --target=build --all"
  },
  "private": true,
  "dependencies": {
    "@better-auth/expo": "1.4.10",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-config": "~0.20.14",
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "better-auth": "1.4.10",
    "drizzle-orm": "0.45.1",
    "expo": "~53.0.10",
    "expo-crypto": "15.0.8",
    "expo-font": "^14.0.10",
    "expo-linking": "~8.0.11",
    "expo-network": "~8.0.8",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.8",
    "expo-web-browser": "~15.0.10",
    "next": "~15.2.4",
    "openai": "^6.8.1",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.3",
    "react-native-get-random-values": "^1.10.0",
