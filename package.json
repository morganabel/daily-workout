  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12 <13",
      "onFail": "error"
    }
  },
  "nx": {
    "includedScripts": []
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "workspaces": [
