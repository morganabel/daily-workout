{
  "name": "@leveza/server-auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@leveza/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "server-auth",
    "targets": {
      "integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": false,
        "options": {
          "cwd": "packages/server-auth",
          "command": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand"
        }
      }
    }
  },
  "dependencies": {
    "@leveza/server-core": "*",
    "@leveza/server-db": "*",
    "better-auth": "*",
    "@better-auth/expo": "*",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4"
  }
}
